            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    white_bowl_1 - white_bowl
    butter_1 - butter
    popcorn_1 - popcorn
    ketchup_1 - ketchup
    milk_1 - milk
    cookies_1 - cookies
