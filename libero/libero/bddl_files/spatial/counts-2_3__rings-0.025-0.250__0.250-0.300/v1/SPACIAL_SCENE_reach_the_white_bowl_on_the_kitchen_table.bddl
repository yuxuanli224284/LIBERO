          (:ranges (
              (0.03861274675086281 0.08764323418699262 0.040612746750862815 0.08964323418699262)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_0_region
          (:target kitchen_table)
          (:ranges (
              (0.1373108392690047 0.22295702848456317 0.1393108392690047 0.22495702848456317)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_1_region
