              (0.2516565476489397 -0.07384836557698977 0.2536565476489397 -0.07184836557698977)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
