    (On popcorn_1 kitchen_table_popcorn_0_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_0_region)
    (On milk_1 kitchen_table_milk_1_1_region)
    (On cookies_1 kitchen_table_cookies_1_2_region)
  )

  (:goal
