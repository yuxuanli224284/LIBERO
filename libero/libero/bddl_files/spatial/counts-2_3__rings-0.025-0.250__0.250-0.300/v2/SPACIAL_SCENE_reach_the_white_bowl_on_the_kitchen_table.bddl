            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (popcorn_0_1_region
          (:target kitchen_table)
          (:ranges (
              (0.024715392598386465 0.16567380298963374 0.026715392598386466 0.16767380298963375)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_0_region
          (:target kitchen_table)
          (:ranges (
              (-0.06906524916798122 -0.2569854058701996 -0.06706524916798122 -0.2549854058701996)
            )
          )
          (:yaw_rotation (
