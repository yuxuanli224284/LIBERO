(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the white bowl into the cabinet)
    (:regions
      (white_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 -0.025 0.025 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (butter_0_0_region
          (:target kitchen_table)
          (:ranges (
              (-0.08178304871794013 -0.048369032775509434 -0.07978304871794013 -0.04636903277550943)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_0_region
          (:target kitchen_table)
          (:ranges (
              (-0.1441780612777089 0.2203335296913946 -0.1421780612777089 0.2223335296913946)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    white_bowl_1 - white_bowl
    butter_1 - butter
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    white_bowl_1
  )

  (:init
    (On white_bowl_1 kitchen_table_white_bowl_init_region)
    (On butter_1 kitchen_table_butter_0_0_region)
    (On ketchup_1 kitchen_table_ketchup_1_0_region)
  )

  (:goal
    (And (reached white_bowl_1))
  )

)
