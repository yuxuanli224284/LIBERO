(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the white bowl into the cabinet)
    (:regions
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 -0.025 0.025 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (yellow_book_0_region
          (:target kitchen_table)
          (:ranges (
              (0.028652663298238942 -0.048112074586662765 0.07865266329823895 0.0018879254133372346)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (butter_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.15231509345856237 -0.08638682026975439 -0.10231509345856238 -0.03638682026975439)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    yellow_book_1 - yellow_book
    butter_1 - butter
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On yellow_book_1 kitchen_table_yellow_book_0_region)
    (On butter_1 kitchen_table_butter_1_region)
  )

  (:goal
    (And (reached akita_black_bowl_1))
  )

)
