(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Reach the white bowl)
    (:regions
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 -0.025 0.025 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.23972095389843953 -0.07077526166086963 -0.17972095389843953 -0.010775261660869631)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.18182114676518624 -0.010924185357170374 0.23182114676518623 0.03907581464282963)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wooden_shelf_1_region
          (:target kitchen_table)
          (:ranges (
              (0.21373644195233008 0.06799099620099058 0.27373644195233005 0.12799099620099058)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target white_cabinet_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
      (top_side
          (:target wooden_shelf_1)
      )
      (top_region
          (:target wooden_shelf_1)
      )
      (middle_region
          (:target wooden_shelf_1)
      )
      (bottom_region
          (:target wooden_shelf_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
    wooden_shelf_1 - wooden_shelf
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On milk_1 white_cabinet_1_top_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On wooden_shelf_1 kitchen_table_wooden_shelf_1_region)
  )

  (:goal
    (And (reached akita_black_bowl_1))
  )

)
